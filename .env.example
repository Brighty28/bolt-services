# Bolt Services — Environment Variables
# Copy this file to .env and fill in your values (or set in Plesk Node.js settings)

# Server port (Plesk/Passenger will set this automatically)
PORT=3000

# SMTP Configuration (required for contact form emails)
SMTP_HOST=send.one.com
SMTP_PORT=587
SMTP_USER=assist@boltservices.co.uk
SMTP_PASS=
SMTP_FROM=assist@boltservices.co.uk
SMTP_TO=info@boltservices.co.uk
